# syntax=docker/dockerfile:1.7

# Recommended Vast-compatible CUDA 12.8 base with Python 3.12.
ARG BASE_IMAGE=vastai/base-image:cuda-12.8.1-cudnn-devel-ubuntu22.04-py312
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/hf-cache \
    TRANSFORMERS_CACHE=/opt/hf-cache \
    TORCH_HOME=/opt/torch-cache \
    PREINSTALLED_VENV=/venv/main \
    VENV_PATH=/opt/venv \
    APP_ROOT=/opt/StereoCrafter

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ffmpeg \
    ca-certificates \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    if [ -x "${PREINSTALLED_VENV}/bin/python" ]; then \
      PY312_BIN="${PREINSTALLED_VENV}/bin/python"; \
    elif command -v python3.12 >/dev/null 2>&1; then \
      PY312_BIN="$(command -v python3.12)"; \
    else \
      echo "Python 3.12 interpreter not found (expected in ${PREINSTALLED_VENV}/bin/python or python3.12)." >&2; \
      exit 1; \
    fi; \
    "${PY312_BIN}" --version; \
    "${PY312_BIN}" -m venv "${VENV_PATH}"
ENV PATH="${VENV_PATH}/bin:${PATH}"

RUN "${VENV_PATH}/bin/python" - <<'PY'
import sys
major, minor = sys.version_info[:2]
assert (major, minor) == (3, 12), f"Expected Python 3.12, found {major}.{minor}"
print(f"Python version OK: {major}.{minor}")
PY

# Install Python dependencies from this workspace's pinned requirements.
COPY requirements.linux.txt /tmp/requirements.linux.txt
RUN python -m pip install --upgrade pip wheel setuptools && \
    python -m pip install -r /tmp/requirements.linux.txt && \
    rm -f /tmp/requirements.linux.txt

# Startup helper.
RUN cat > /usr/local/bin/stereocrafter-onstart.sh <<'SH' && chmod +x /usr/local/bin/stereocrafter-onstart.sh
#!/usr/bin/env bash
set -euo pipefail

# If the secret is supplied under either name, normalize to HF_TOKEN.
if [[ -n "${HUGGING_FACE_HUB_TOKEN:-}" && -z "${HF_TOKEN:-}" ]]; then
  export HF_TOKEN="${HUGGING_FACE_HUB_TOKEN}"
fi

cd "${APP_ROOT}"
exec "$@"
SH

ENTRYPOINT ["/usr/local/bin/stereocrafter-onstart.sh"]
CMD ["bash"]

# Last step: clone your repository branch into the runtime app path.
ARG GIT_REPO_URL=https://github.com/REPLACE_WITH_YOUR_USER/StereoCrafter.git
ARG GIT_BRANCH=main
ARG GIT_COMMIT=
ARG GIT_CACHE_BUST=0
RUN set -eux; \
    echo "git-cache-bust=${GIT_CACHE_BUST}"; \
    git clone --depth 1 --branch "${GIT_BRANCH}" "${GIT_REPO_URL}" "${APP_ROOT}"; \
    git -C "${APP_ROOT}" pull --ff-only origin "${GIT_BRANCH}"; \
    if [ -n "${GIT_COMMIT}" ]; then \
      git -C "${APP_ROOT}" fetch --depth 1 origin "${GIT_COMMIT}"; \
      git -C "${APP_ROOT}" checkout --detach "${GIT_COMMIT}"; \
    fi; \
    git -C "${APP_ROOT}" rev-parse HEAD | tee /opt/stereocrafter_git_commit.txt

# Optional accelerator: best-effort flash-attn install.
# Kept near the end to avoid invalidating earlier cached layers.
ARG FLASH_ATTN_PIP_SPEC=flash-attn
RUN set -eux; \
    FLASH_ATTN_PIP_SPEC="${FLASH_ATTN_PIP_SPEC}" python - <<'PY'
import importlib
import os
import subprocess
import sys

spec = os.environ.get("FLASH_ATTN_PIP_SPEC", "flash-attn").strip() or "flash-attn"
print(f"[docker] Optional flash-attn check (spec={spec})", flush=True)

try:
    importlib.import_module("flash_attn")
    print("[docker] flash-attn already installed.", flush=True)
    raise SystemExit(0)
except Exception:
    pass

# Best-effort only: keep image build succeeding even when no compatible wheel/build is available.
subprocess.run([sys.executable, "-m", "pip", "install", "--no-build-isolation", "ninja"], check=False)
proc = subprocess.run(
    [sys.executable, "-m", "pip", "install", "--no-build-isolation", spec],
    check=False,
    text=True,
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
)
if proc.returncode != 0:
    output = (proc.stdout or "").strip()
    tail = "\n".join(output.splitlines()[-20:]) if output else ""
    print("[docker] Optional flash-attn install failed; continuing image build.", flush=True)
    if tail:
        print(tail, flush=True)
    raise SystemExit(0)

try:
    importlib.import_module("flash_attn")
    print("[docker] flash-attn installed successfully.", flush=True)
except Exception as exc:
    print(f"[docker] flash-attn install completed but import failed ({exc}); continuing.", flush=True)
PY

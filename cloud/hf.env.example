# Copy to cloud/hf.env and fill real values. This file is gitignored.
# Either HF_TOKEN or HUGGING_FACE_HUB_TOKEN is accepted.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional cache locations inside the container.
HF_HOME=/opt/hf-cache
TRANSFORMERS_CACHE=/opt/hf-cache
TORCH_HOME=/opt/torch-cache
